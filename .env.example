# ---------------------------------------------------------------------------
# NIB Property Valuation Management System - environment template
# Copy to .env and fill in. NEVER commit a populated .env (see .gitignore).
# ---------------------------------------------------------------------------

NODE_ENV=development
# Deployment environment. Defaults to NODE_ENV when unset, so a deployment that
# forgets it still gets the strict production checks. Set to development on a
# workstation so that a local production build is possible.
APP_ENV=development
APP_URL=http://localhost:3008
# Reverse proxies in front of the app that append to X-Forwarded-For (nginx,
# IIS/ARR, a load balancer). The client address is read that many entries from
# the right. 1 = one reverse proxy, and is also right for local development.
TRUSTED_PROXY_HOPS=1

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nib_valuation?schema=public"

# --- Session / crypto -------------------------------------------------------
# 32+ random bytes, base64. Generate: openssl rand -base64 48
SESSION_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_48"
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# --- File storage -----------------------------------------------------------
# STORAGE_DRIVER: local | s3
STORAGE_DRIVER=local
# Uploaded files live OUTSIDE the code folder; a path inside the project is
# refused at start-up. Unset defaults to ../NibValutionStorage beside the project.
STORAGE_LOCAL_ROOT=../NibValutionStorage
# S3 / object storage (production)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Malware scanning -------------------------------------------------------
# SCANNER_DRIVER: none | clamav
# In production, "none" causes uploads to be quarantined rather than released.
SCANNER_DRIVER=none
CLAMAV_HOST=
CLAMAV_PORT=3310

# --- Mail -------------------------------------------------------------------
# MAIL_DRIVER: log (write to the server log only) | smtp (send through the relay)
# The EMAIL_HOST / EMAIL_PORT / EMAIL_USER / EMAIL_PASS / EMAIL_FROM /
# EMAIL_ALLOW_SELF_SIGNED names used by other NIB systems are accepted too.
# Check the relay with: npx tsx scripts/ops/mail-check.mts [recipient]
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true accepts a self-signed relay certificate (still encrypted, identity unchecked)
SMTP_ALLOW_SELF_SIGNED=false
MAIL_FROM="NIB Property Valuation <no-reply@nibbank.example>"

# --- SMS --------------------------------------------------------------------
SMS_DRIVER=log
SMS_API_URL=
SMS_API_KEY=

# --- Scheduled jobs ----------------------------------------------------------
# Bearer token for GET /api/cron/sla (run every 15 minutes by the scheduler).
# Leave empty to disable; the SLA sweep still runs on page loads.
CRON_SECRET=

# --- Digital signature ------------------------------------------------------
# SIGNATURE_PROVIDER: local | external
SIGNATURE_PROVIDER=local
# PEM-encoded EC P-256 private key for the local provider. In production this
# must come from a KMS / secret store, not from an environment variable.
SIGNATURE_LOCAL_PRIVATE_KEY=
# Public keys of signing keys retired by rotation (PEMs, one after another), so
# reports signed before a rotation still verify. Nothing is signed with them.
SIGNATURE_RETIRED_PUBLIC_KEYS=
SIGNATURE_EXTERNAL_URL=
SIGNATURE_EXTERNAL_API_KEY=

# --- Seeding ----------------------------------------------------------------
# Password applied to seeded development accounts. Required by `npm run db:seed`
# outside production; seeding is refused entirely when NODE_ENV=production.
SEED_DEFAULT_PASSWORD=
